                      "state": {
                        "type": "string"
                      },
                      "postalCode": {
                        "type": "string"
                      },
                      "phone": {
                        "type": "string"
                      }
                    }
                  },
                  "termsAccepted": {
                    "const": true
                  },
                  "idempotencyKey": {
                    "type": "string"
                  }
                },
                "required": [
                  "items",
                  "shippingType",
                  "address",
                  "termsAccepted",
                  "idempotencyKey"
                ]
              },
              "example": {
                "items": [
                  {
                    "productId": 1,
                    "size": "M",
                    "quantity": 2
                  }
                ],
                "shippingType": "recoger",
                "address": {
                  "recipient": "Clienta de prueba",
                  "street": "Calle Ejemplo 10",
                  "neighborhood": "Centro",
                  "city": "Nuevo Laredo",
                  "state": "Tamaulipas",
                  "postalCode": "88000",
                  "phone": "0000000000"
                },
                "termsAccepted": true,
                "idempotencyKey": "pedido-demo-00001"
              }
            }
          }
