          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "productId",
                        "size",
                        "quantity"
                      ],
                      "properties": {
                        "productId": {
                          "type": "integer"
                        },
                        "size": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10
                        }
                      }
                    },
                    "minItems": 1,
                    "maxItems": 20
                  },
                  "shippingType": {
                    "enum": [
                      "estandar",
                      "express",
                      "recoger"
                    ]
                  },
                  "coupon": {
                    "type": "string"
                  }
                },
                "required": [
                  "items"
                ]
              }
            }
          }
        }
      }
    },
