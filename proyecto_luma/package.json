{
  "name": "luma-store-spark",
  "version": "2.1.0",
  "private": true,
  "description": "LUMA STORE: Angular + Firebase Hosting/Auth/Firestore en Spark gratis; operaciones académicas simuladas",
  "scripts": {
    "start": "ng serve",
    "dev": "ng serve",
    "build": "ng build",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "verificar:firebase": "node tools/verificar-vinculacion.mjs",
    "vincular:config": "node tools/importar-config-firebase.mjs firebase-js-config.json"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "firebase": "^12.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
