rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function admin() {
      return signed() &&
        exists(/databases/$(database)/documents/adminUsers/$(me())) &&
        get(/databases/$(database)/documents/adminUsers/$(me())).data.enabled == true;
    }
    function own(uid) { return signed() && me() == uid; }
    function text(v, maxSize) { return v is string && v.size() <= maxSize; }
    function safeNumber(n) { return n is number && n >= 0 && n <= 1000000000; }

    // Los permisos administrativos no son modificables por el navegador.
    // Configura adminUsers/UID {enabled:true} desde Firebase Console.
    match /adminUsers/{uid} {
      allow get: if own(uid) || admin();
      allow list: if admin();
      allow create, update, delete: if false;
    }

    match /users/{uid} {
      allow get: if own(uid) || admin();
      allow list: if admin();
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly(['id','name','email','role','phone','wishlist','addresses','created_at'])
        && request.resource.data.id == uid
        && request.resource.data.role == 'cliente'
        && request.resource.data.email == request.auth.token.email
        && text(request.resource.data.name,80)
        && request.resource.data.wishlist is list
        && request.resource.data.wishlist.size() == 0
        && request.resource.data.addresses is list
        && request.resource.data.addresses.size() == 0;
      allow update: if own(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','wishlist','addresses'])
        && request.resource.data.role == 'cliente'
        && text(request.resource.data.name,80)
        && request.resource.data.wishlist is list
        && request.resource.data.wishlist.size() <= 100
        && request.resource.data.addresses is list
        && request.resource.data.addresses.size() <= 5;
      allow delete: if false;
    }

    match /products/{id} {
      allow read: if true;
      allow create,update,delete: if admin();
    }
    match /categories/{id} {
      allow read: if true;
      allow create,update,delete: if admin();
    }
    match /coupons/{id} {
      function redeemsCoupon() {
        let key = request.resource.data.last_order_key;
        let orderId = me() + '_' + key;
        let order = /databases/$(database)/documents/orders/$(orderId);
        return signed()
          && key is string
          && key.matches('^[A-Za-z0-9_-]{12,100}$')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used','last_order_key'])
          && resource.data.active == 1
          && resource.data.used < resource.data.max_uses
          && request.resource.data.used == resource.data.used + 1
          && !exists(order)
          && getAfter(order).data.user_id == me()
          && getAfter(order).data.coupon_code == id
          && getAfter(order).data.subtotal >= resource.data.minimum;
      }
      allow read: if true;
      allow create,delete: if admin();
      allow update: if admin() || redeemsCoupon();
    }

    // IMPORTANTE: pedidos SIMULADOS. No son ventas válidas ni verificación
    // de precios ni procesamiento de pagos. La regla limita su alcance.
    match /orders/{id} {
      function ownOrderId() {
        return id.matches('^' + me() + '_[A-Za-z0-9_-]{12,100}$');
      }
      function appliesCoupon(code) {
        let coupon = /databases/$(database)/documents/coupons/$(code);
        return code is string
          && code.matches('^[A-Z0-9_-]{3,20}$')
          && getAfter(coupon).data.used == get(coupon).data.used + 1
          && me() + '_' + getAfter(coupon).data.last_order_key == id;
      }
      // La transacción consulta el folio antes de crear el pedido.
      allow get: if signed() && (
        (resource == null && ownOrderId()) ||
        (resource != null && resource.data.user_id == me()) ||
        admin()
      );
      allow list: if signed() && (resource.data.user_id == me() || admin());
      allow create: if signed()
        && ownOrderId()
        && request.resource.data.user_id == me()
        && request.resource.data.order_doc_id == id
        && request.resource.data.mode == 'spark-demo'
        && request.resource.data.status == 'simulado'
        && request.resource.data.payment_status == 'simulado'
        && request.resource.data.payment_method == 'simulado'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && safeNumber(request.resource.data.subtotal)
        && safeNumber(request.resource.data.discount)
        && safeNumber(request.resource.data.shipping)
        && safeNumber(request.resource.data.total)
        && ('coupon_code' in request.resource.data
          ? appliesCoupon(request.resource.data.coupon_code)
          : request.resource.data.discount == 0)
        && request.resource.data.keys().hasOnly([
          'id','folio','user_id','customer_name','customer_email','status',
          'payment_status','payment_method','subtotal','discount','shipping','total',
          'shipping_type','address','tracking','created_at','terms_version',
          'terms_accepted_at','items','mode','order_doc_id','coupon_code'
        ]);
      allow update,delete: if admin();
    }

    match /returns/{id} {
      allow get,list: if signed() && (resource.data.user_id == me() || admin());
      allow create: if signed()
        && request.resource.data.user_id == me()
        && request.resource.data.id is number
        && request.resource.data.status == 'solicitada'
        && request.resource.data.order_doc_id is string
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.order_doc_id))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.order_doc_id)).data.user_id == me()
        && text(request.resource.data.reason,100)
        && text(request.resource.data.detail,500);
      allow update,delete: if admin();
    }

    match /contact_tickets/{id} {
      allow get,list: if signed() && (resource.data.user_id == me() || admin());
      allow create: if signed()
        && request.resource.data.user_id == me()
        && request.resource.data.status == 'abierto'
        && text(request.resource.data.name,90)
        && text(request.resource.data.email,120)
        && text(request.resource.data.message,2000);
      allow update,delete: if admin();
    }

    match /inventory_movements/{id} {
      allow read,write: if admin();
    }
    match /audit_logs/{id} {
      allow read,write: if admin();
    }
    match /{document=**} { allow read,write: if false; }
  }
}
